<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/oos_about_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layoutAnimation="@anim/descartes_stagger"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/descartes_about_margin"
    android:paddingBottom="8dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/about_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/descartes_about_banner_bg"
        android:clipToOutline="true">

        <ImageView
            android:id="@+id/about_banner_art"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop"
            android:src="@drawable/descartes_about_banner"
            app:layout_constraintDimensionRatio="H,1.25:1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:layoutAnimation="@anim/descartes_stagger"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="@id/about_banner_art"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/about_banner_art"
            app:layout_constraintVertical_bias="0.4">

            <TextView
                android:id="@+id/about_os_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="variable-display-large-emphasized"
                android:shadowColor="#33000000"
                android:shadowDy="2"
                android:shadowRadius="16"
                android:text="@string/descartes_about_os_name"
                android:textColor="@android:color/white"
                android:textSize="48sp" />

            <TextView
                android:id="@+id/about_os_version"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/descartes_about_pill"
                android:fontFamily="variable-label-large-emphasized"
                android:paddingHorizontal="14dp"
                android:paddingVertical="6dp"
                android:textColor="@android:color/white"
                android:textSize="14sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/about_update_pill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:background="@drawable/descartes_about_update_button"
            android:drawableStart="@drawable/descartes_glyph_update"
            android:drawablePadding="8dp"
            android:focusable="true"
            android:fontFamily="variable-title-medium-emphasized"
            android:gravity="center_vertical"
            android:minHeight="52dp"
            android:paddingHorizontal="22dp"
            android:stateListAnimator="@animator/descartes_press"
            android:text="@string/descartes_about_system_updates"
            android:textColor="@color/settingslib_materialColorOnPrimaryContainer"
            android:textSize="16sp"
            app:layout_constraintBottom_toBottomOf="@id/about_banner_art"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <LinearLayout
        android:id="@+id/about_device_name_row"
        style="@style/DescartesAboutRow"
        android:layout_marginTop="@dimen/descartes_about_card_gap"
        android:background="@drawable/descartes_about_seg_top"
        android:orientation="horizontal">

        <TextView
            style="@style/DescartesAboutRowTitle"
            android:text="@string/my_device_info_device_name_preference_title" />

        <TextView
            android:id="@+id/device_name"
            style="@style/DescartesAboutRowValue" />

        <ImageView style="@style/DescartesAboutChevron" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/about_storage_row"
        style="@style/DescartesAboutRow"
        android:layout_marginTop="@dimen/descartes_about_seg_gap"
        android:background="@drawable/descartes_about_seg_bottom"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/DescartesAboutRowTitle"
                android:text="@string/descartes_about_storage" />

            <TextView
                android:id="@+id/rom_about"
                style="@style/DescartesAboutRowValue" />

            <ImageView style="@style/DescartesAboutChevron" />
        </LinearLayout>

        <com.android.settings.widget.WavyProgressView
            android:id="@+id/rom_progress_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/descartes_about_card_gap"
        android:background="@drawable/descartes_about_hero"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/device_model"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="variable-headline-small-emphasized"
                android:textColor="@color/settingslib_materialColorOnPrimaryContainer"
                android:textSize="24sp" />

            <TextView
                android:id="@+id/build_number"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:alpha="0.8"
                android:textColor="@color/settingslib_materialColorOnPrimaryContainer"
                android:textIsSelectable="true"
                android:textSize="14sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/android_version"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:layout_marginStart="12dp"
            android:contentDescription="@string/firmware_version"
            android:scaleType="fitCenter"
            android:src="@drawable/A17" />
    </LinearLayout>

    <LinearLayout
        style="@style/DescartesAboutSpecTile"
        android:layout_width="match_parent"
        android:layout_marginTop="@dimen/descartes_about_card_gap"
        android:background="@drawable/descartes_about_seg_top">

        <FrameLayout style="@style/DescartesAboutSpecIcon">

            <ImageView
                android:id="@+id/soc_shape"
                style="@style/DescartesAboutSpecShape"
                android:src="@drawable/descartes_shape_cookie"
                android:tint="@color/settingslib_materialColorPrimaryContainer" />

            <ImageView
                style="@style/DescartesAboutSpecGlyph"
                android:src="@drawable/descartes_glyph_processor"
                android:tint="@color/settingslib_materialColorOnPrimaryContainer" />
        </FrameLayout>

        <TextView
            style="@style/DescartesAboutSpecLabel"
            android:text="@string/text_processor" />

        <TextView
            android:id="@+id/soc_about"
            style="@style/DescartesAboutSpecValue" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/about_memory_battery_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/descartes_about_seg_gap"
        android:orientation="horizontal">

        <LinearLayout
            style="@style/DescartesAboutSpecTile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/descartes_about_seg_mid">

            <FrameLayout style="@style/DescartesAboutSpecIcon">

                <ImageView
                    android:id="@+id/ram_shape"
                    style="@style/DescartesAboutSpecShape"
                    android:src="@drawable/descartes_shape_squircle"
                    android:tint="@color/settingslib_materialColorSecondaryContainer" />

                <ImageView
                    style="@style/DescartesAboutSpecGlyph"
                    android:src="@drawable/ic_settings_memory"
                    android:tint="@color/settingslib_materialColorOnSecondaryContainer" />
            </FrameLayout>

            <TextView
                style="@style/DescartesAboutSpecLabel"
                android:text="@string/descartes_about_ram" />

            <TextView
                android:id="@+id/ram_about"
                style="@style/DescartesAboutSpecValue" />
        </LinearLayout>

        <Space
            android:layout_width="@dimen/descartes_about_seg_gap"
            android:layout_height="match_parent" />

        <LinearLayout
            style="@style/DescartesAboutSpecTile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/descartes_about_seg_mid">

            <FrameLayout style="@style/DescartesAboutSpecIcon">

                <ImageView
                    android:id="@+id/battery_shape"
                    style="@style/DescartesAboutSpecShape"
                    android:src="@drawable/descartes_shape_burst"
                    android:tint="@color/settingslib_materialColorTertiaryContainer" />

                <ImageView
                    style="@style/DescartesAboutSpecGlyph"
                    android:src="@drawable/ic_battery_full"
                    android:tint="@color/settingslib_materialColorOnTertiaryContainer" />
            </FrameLayout>

            <TextView
                style="@style/DescartesAboutSpecLabel"
                android:text="@string/text_battery" />

            <TextView
                android:id="@+id/battery_about"
                style="@style/DescartesAboutSpecValue" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/about_display_camera_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/descartes_about_seg_gap"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/display_section"
            style="@style/DescartesAboutSpecTile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/descartes_about_seg_bottom_start">

            <FrameLayout style="@style/DescartesAboutSpecIcon">

                <ImageView
                    android:id="@+id/display_shape"
                    style="@style/DescartesAboutSpecShape"
                    android:src="@drawable/descartes_shape_clover"
                    android:tint="@color/settingslib_materialColorSecondaryContainer" />

                <ImageView
                    style="@style/DescartesAboutSpecGlyph"
                    android:src="@drawable/ic_settings_display"
                    android:tint="@color/settingslib_materialColorOnSecondaryContainer" />
            </FrameLayout>

            <TextView
                style="@style/DescartesAboutSpecLabel"
                android:text="@string/text_display" />

            <TextView
                android:id="@+id/display_about"
                style="@style/DescartesAboutSpecValue" />
        </LinearLayout>

        <Space
            android:id="@+id/camera_gap"
            android:layout_width="@dimen/descartes_about_seg_gap"
            android:layout_height="match_parent" />

        <LinearLayout
            android:id="@+id/camera_section"
            style="@style/DescartesAboutSpecTile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/descartes_about_seg_bottom_end">

            <FrameLayout style="@style/DescartesAboutSpecIcon">

                <ImageView
                    android:id="@+id/camera_shape"
                    style="@style/DescartesAboutSpecShape"
                    android:src="@drawable/descartes_shape_flower"
                    android:tint="@color/settingslib_materialColorPrimaryContainer" />

                <ImageView
                    style="@style/DescartesAboutSpecGlyph"
                    android:src="@drawable/descartes_glyph_camera"
                    android:tint="@color/settingslib_materialColorOnPrimaryContainer" />
            </FrameLayout>

            <TextView
                style="@style/DescartesAboutSpecLabel"
                android:text="@string/descartes_about_cameras" />

            <TextView
                android:id="@+id/camera_rear"
                style="@style/DescartesAboutSpecValue" />

            <TextView
                android:id="@+id/camera_front"
                style="@style/DescartesAboutSpecDetail" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
