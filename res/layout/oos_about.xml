<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/oos_about_root"
    android:layoutAnimation="@anim/descartes_stagger"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/descartes_about_margin"
    android:paddingBottom="8dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/about_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/descartes_about_banner_bg"
        android:clipToOutline="true">

        <ImageView
            android:id="@+id/about_banner_art"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:scaleType="centerCrop"
            android:src="@drawable/descartes_about_banner"
            android:importantForAccessibility="no"
            app:layout_constraintDimensionRatio="H,1.3:1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:layoutAnimation="@anim/descartes_stagger"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="@id/about_banner_art"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/about_banner_art"
            app:layout_constraintVertical_bias="0.42">

            <TextView
                android:id="@+id/about_os_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="variable-display-medium-emphasized"
                android:shadowColor="#40000000"
                android:shadowDy="2"
                android:shadowRadius="12"
                android:text="@string/descartes_about_os_name"
                android:textColor="@android:color/white"
                android:textSize="44sp" />

            <TextView
                android:id="@+id/about_os_version"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="variable-title-medium"
                android:shadowColor="#40000000"
                android:shadowDy="1"
                android:shadowRadius="8"
                android:textColor="@android:color/white"
                android:textSize="16sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/about_update_pill"
            android:stateListAnimator="@animator/descartes_press"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="28dp"
            android:background="@drawable/descartes_about_pill"
            android:focusable="true"
            android:fontFamily="variable-title-small"
            android:foreground="?android:attr/selectableItemBackground"
            android:paddingHorizontal="20dp"
            android:paddingVertical="10dp"
            android:text="@string/descartes_about_system_updates"
            android:textColor="@android:color/white"
            android:textSize="15sp"
            app:layout_constraintBottom_toBottomOf="@id/about_banner_art"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/descartes_about_card_gap"
        android:background="@drawable/descartes_about_card"
        android:orientation="vertical"
        android:paddingVertical="6dp">

        <LinearLayout
            android:id="@+id/about_device_name_row"
            style="@style/DescartesAboutRow"
            android:orientation="horizontal">

            <TextView
                style="@style/DescartesAboutRowTitle"
                android:text="@string/my_device_info_device_name_preference_title" />

            <TextView
                android:id="@+id/device_name"
                style="@style/DescartesAboutRowValue" />

            <ImageView style="@style/DescartesAboutChevron" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/about_storage_row"
            style="@style/DescartesAboutRow"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/DescartesAboutRowTitle"
                    android:text="@string/descartes_about_storage" />

                <TextView
                    android:id="@+id/rom_about"
                    style="@style/DescartesAboutRowValue" />

                <ImageView style="@style/DescartesAboutChevron" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/rom_progress_bar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_marginTop="12dp"
                android:max="100"
                android:progressDrawable="@drawable/descartes_about_progress" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/descartes_about_card_gap"
        android:background="@drawable/descartes_about_card"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingVertical="18dp">

        <TextView
            android:id="@+id/device_model"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="variable-title-medium"
            android:textColor="@color/settingslib_materialColorOnSurface"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/build_number"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/settingslib_materialColorOnSurfaceVariant"
            android:textIsSelectable="true"
            android:textSize="14sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="16dp"
            android:background="@color/settingslib_materialColorOutlineVariant" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/DescartesAboutSpecLabel"
                    android:layout_marginTop="0dp"
                    android:text="@string/text_processor" />

                <TextView
                    android:id="@+id/soc_about"
                    style="@style/DescartesAboutSpecValue" />

                <TextView
                    style="@style/DescartesAboutSpecLabel"
                    android:text="@string/descartes_about_ram" />

                <TextView
                    android:id="@+id/ram_about"
                    style="@style/DescartesAboutSpecValue" />

                <LinearLayout
                    android:id="@+id/camera_section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        style="@style/DescartesAboutSpecLabel"
                        android:text="@string/descartes_about_cameras" />

                    <TextView
                        style="@style/DescartesAboutSpecValue"
                        android:text="@string/descartes_about_camera_system" />

                    <TextView
                        android:id="@+id/camera_front"
                        style="@style/DescartesAboutSpecDetail" />

                    <TextView
                        android:id="@+id/camera_rear"
                        style="@style/DescartesAboutSpecDetail" />
                </LinearLayout>

                <TextView
                    style="@style/DescartesAboutSpecLabel"
                    android:text="@string/text_battery" />

                <TextView
                    android:id="@+id/battery_about"
                    style="@style/DescartesAboutSpecValue" />

                <TextView
                    style="@style/DescartesAboutSpecLabel"
                    android:text="@string/text_display" />

                <TextView
                    android:id="@+id/display_about"
                    style="@style/DescartesAboutSpecValue" />
            </LinearLayout>

            <ImageView
                android:id="@+id/android_version"
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="12dp"
                android:contentDescription="@string/firmware_version"
                android:scaleType="fitCenter"
                android:src="@drawable/A17" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
