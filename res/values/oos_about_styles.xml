<resources>
    <style name="DescartesAboutRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">64dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingHorizontal">20dp</item>
        <item name="android:paddingVertical">16dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="DescartesAboutRowTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">variable-title-medium-emphasized</item>
        <item name="android:textColor">@color/settingslib_materialColorOnSurface</item>
        <item name="android:textSize">17sp</item>
    </style>

    <style name="DescartesAboutRowValue">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginStart">16dp</item>
        <item name="android:ellipsize">end</item>
        <item name="android:gravity">end</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">@color/settingslib_materialColorOnSurfaceVariant</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="DescartesAboutChevron">
        <item name="android:layout_width">20dp</item>
        <item name="android:layout_height">20dp</item>
        <item name="android:layout_marginStart">4dp</item>
        <item name="android:importantForAccessibility">no</item>
        <item name="android:src">@drawable/descartes_about_chevron</item>
    </style>

    <style name="DescartesAboutSpecTile">
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">18dp</item>
    </style>

    <style name="DescartesAboutSpecIcon">
        <item name="android:layout_width">44dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:layout_marginBottom">14dp</item>
    </style>

    <style name="DescartesAboutSpecShape">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:importantForAccessibility">no</item>
    </style>

    <style name="DescartesAboutSpecGlyph">
        <item name="android:layout_width">22dp</item>
        <item name="android:layout_height">22dp</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:importantForAccessibility">no</item>
    </style>

    <style name="DescartesAboutSpecLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/settingslib_materialColorOnSurfaceVariant</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="DescartesAboutSpecValue">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:fontFamily">variable-title-large-emphasized</item>
        <item name="android:textColor">@color/settingslib_materialColorOnSurface</item>
        <item name="android:textIsSelectable">true</item>
        <item name="android:textSize">18sp</item>
    </style>

    <style name="DescartesAboutSpecDetail">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:textColor">@color/settingslib_materialColorOnSurfaceVariant</item>
        <item name="android:textSize">14sp</item>
    </style>
</resources>
